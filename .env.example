NODE_ENV=development
PORT=6000
MONGO_URL=mongodb://127.0.0.1:27017/encryption_api
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace-with-a-long-random-admin-secret
JWT_ACCESS_SECRET=replace-with-a-different-long-random-access-secret
ACTIVATION_TOKEN_SECRET=replace-with-a-different-long-random-activation-secret
SOCKET_CORS_ORIGIN=*
LIVEKIT_URL=https://call.example.com
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret
CALL_INVITE_TTL_SECONDS=45
CALL_EXPIRY_POLL_MS=5000
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
IOS_FIREBASE_PROJECT_ID=must-match-project-id-from-GoogleService-Info.plist
FIREBASE_CLIENT_EMAIL=replace-with-firebase-service-account-email
FIREBASE_PRIVATE_KEY="replace-with-firebase-private-key"
